// {{Name}} — a starter grammar, C-flavoured.
//
// Braces and semicolons: a statement ends at `;`, a block is `{ }`, and
// newlines are ordinary whitespace. `nh init --style basic` writes the same
// language line-oriented instead.
//
// Every comment below marks something easy to get wrong and hard to discover.
// Delete them once you have read them.

grammar {{Name}};

// The operator table. This one line gives you `expr`, precedence,
// associativity, and short-circuiting — there is deliberately no `expr` rule
// anywhere in this file. Run `nh explain {{name}}.nh` to see what you got.
use operators::core;

// Implicit skipping. Declare as many as you like under any names; they are
// unioned together.
skip WHITESPACE = " " | "\t" | "\r" | "\n";
skip COMMENT    = "//" (!"\n" ANY)*;

// `@` marks a token atomic — no inner structure, which is what you want for
// anything lexical.
token DIGIT  = @ "0".."9";
token ALPHA  = @ "a".."z" | "A".."Z";
token NUMBER = @ DIGIT+ ("." DIGIT+)?;
token IDENT  = @ (ALPHA | "_") (ALPHA | DIGIT | "_")*;

// Declare keywords here instead of hand-writing lookaheads. This guards BOTH
// directions: `let` will not match inside `letter`, and `let` cannot be used as
// a variable name. Getting this right by hand is genuinely hard.
reserved from IDENT { "let" "print" "if" "else"{{reserved}} }

// ---------------------------------------------------------------------------
// Rules
// ---------------------------------------------------------------------------

// ANCHOR YOUR ENTRY RULE. Implicit skipping happens *between* elements, never
// before the first one, so without `SOI` a program starting with a blank line
// or a comment will not parse. `SOI`/`EOI` are pest builtins.
rule program = SOI stmts:stmt* EOI -> doc;

// A braced group of statements. Its handler evaluates them in order, so every
// construct that owns a body — `if`, and the loops if you enabled them — takes
// one of these and needs to know nothing about what is inside.
rule block = "{" stmts:stmt* "}" -> body;

// `name:X` is a BINDING — it becomes a named accessor on the generated view, so
// handler code never indexes children by position.
//
// `-> label` names the handler for an alternative. The generated rule is
// `<rule>_<label>`, which is also the handler filename, so labels need not
// repeat the rule name: `-> bind` here gives `stmt_bind`.
//
// `lazy` hands the handler the *unevaluated* node. Everything else arrives
// already evaluated, which is what you want almost everywhere — but a branch
// must not run before it is chosen, and a loop body must run more than once.
rule stmt
  = "let" name:IDENT "=" value:expr ";"                      -> bind
  | "print" value:expr ";"                                   -> print
  | "if" cond:expr lazy then:block lazy otherwise:else_tail? -> iff
{{stmt_loops}}{{stmt_functions}}  | value:expr ";"                                           -> eval
  ;

rule else_tail = "else" lazy body:block -> tail;
{{rules_extra}}
// The rule the operator driver folds over.
rule atom = primary;

// `place` marks an alternative as assignable, which is what makes `x = 1;`
// work — and what makes `x += 1` evaluate its subscript exactly once, if you
// add indexing later.
rule primary
  = digits:NUMBER      -> num
{{primary_call}}  | name:IDENT         -> var place
  | "(" inner:expr ")" -> pass
  ;

// A statement that does not parse is skipped to the next `;` and the parse
// carries on, so one typo does not hide every later error.
recover stmt sync ";";

// Without this, a missing `)` reports pest's internal rule names. With it, it
// reports something a user of *your* language can act on.
expect ")" in primary as "closing parenthesis";
