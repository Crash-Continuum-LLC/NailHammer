{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo build --workspace",
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo test --workspace",
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "nh: check the open grammar",
      "type": "nailhammer",
      "command": "check",
      "problemMatcher": [
        "$nh"
      ]
    },
    {
      "label": "nh: build the open grammar",
      "type": "nailhammer",
      "command": "build",
      "problemMatcher": [
        "$nh"
      ]
    }
  ]
}
