// A small C-flavoured language that compiles to `nh-vm` bytecode.
//
// Its twin is `examples/vm-basic`, which is the same language wearing BASIC's
// syntax. Neither implements a single operator: `nh build --target nh-vm`
// generates all of that, and the two grammars bind the *same roles*, so `&`
// here and `AND` there reach one instruction.
grammar CLang;

use operators::none;

skip WHITESPACE = " " | "\t" | "\r" | "\n";

token DIGIT = @ "0".."9";
token ALPHA = @ "a".."z" | "A".."Z";
token NUMBER = @ DIGIT+ ("." DIGIT+)?;
token IDENT = @ (ALPHA | "_") (ALPHA | DIGIT | "_")*;
token STRING = @ "\"" (!"\"" ANY)* "\"";

reserved from IDENT { "print" "if" "while" "await" "len" "fn" "return" }

// The operator table is the language's own; the instructions it lowers to are
// the machine's. That split is the whole point of the target.
precedence {
    right  "=" -> assign;
    left   "||" -> or_else;
    left   "&&" -> and_then;
    left   "|" -> bit_or;
    left   "^" -> bit_xor;
    left   "&" -> bit_and;
    left   "==" | "!=" | "<" | "<=" | ">" | ">=" -> compare;
    left   "+" | "-";
    left   "*" | "/";
    prefix "-";
    prefix "!" -> not;
    prefix word "await" -> await;
    prefix word "len" -> len;
    atom   atom;
}

rule program = SOI body:stmt+ EOI -> program;

rule stmt
  = "print" value:expr ";"                             -> print
  | "if" "(" cond:expr ")" lazy body:block             -> iff
  | "while" "(" lazy cond:expr ")" lazy body:block     -> whilst
  | "fn" name:IDENT "(" (params:IDENT ","?)* ")" lazy body:block -> define
  | "return" value:expr ";"                            -> ret
  | value:expr ";"                                     -> eval
  ;

// `lazy` above hands these over *unemitted*, so a handler can put a jump in
// front of the body and — for `while` — emit the condition at the loop top
// rather than before the loop exists.
rule block = "{" body:stmt+ "}" -> block;

rule atom = primary;

rule primary
  = value:NUMBER                      -> num
  | text:STRING                       -> str
  | name:IDENT "[" index:expr "]"     -> elem place
  | name:IDENT "(" args:exprs ")"     -> call
  | name:IDENT                        -> var place
  | "[" first:expr rest:more_elem* "]" -> list
  | "(" inner:expr ")"                -> pass
  ;

// `a[i]` is a `place`, so it can be assigned to as well as read. The generator
// recognises it structurally -- one name, one evaluated index -- rather than by
// spelling, so a BASIC could write `a(i)` and get the same store.
rule more_elem = "," value:expr -> next;

// Arguments are expressions; parameters are bound as *names* directly in the
// `define` alternative above, repeated so they arrive as a list. A call and a
// definition cannot share a rule for exactly that reason.
rule exprs = first:expr rest:more_elem* -> some;
