nh_op_gt = @{ ">" }
nh_op_caret = @{ "^" }
nh_op_pipe = @{ "|" }
nh_bin_op = _{ nh_op_bang_eq | nh_op_amp_amp | nh_op_lt_eq | nh_op_eq_eq | nh_op_gt_eq | nh_op_pipe_pipe | nh_op_amp | nh_op_star | nh_op_plus | nh_op_minus | nh_op_slash | nh_op_lt | nh_op_eq | nh_op_gt | nh_op_caret | nh_op_pipe }
