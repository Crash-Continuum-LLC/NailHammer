STRING = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

// Expressions (operator table is resolved at build time)
expr = { nh_pre_op* ~ atom ~ (nh_bin_op ~ nh_pre_op* ~ atom)* }

