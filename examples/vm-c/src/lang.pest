primary = { primary_num | primary_str | primary_elem | primary_call | primary_var | primary_list | "(" ~ #inner = expr ~ ")" }
primary_num = { #value = NUMBER_ }
primary_str = { #text = STRING }
primary_elem = { #name = IDENT ~ "[" ~ #index = expr ~ "]" }
primary_call = { #name = IDENT ~ "(" ~ (#args = exprs)? ~ ")" }
primary_var = { #name = IDENT }
primary_list = { "[" ~ #first = expr ~ (#rest = more_elem)* ~ "]" }
more_elem = { "," ~ #value = expr }
exprs = { #first = expr ~ (#rest = more_elem)* }

// ---------------------------------------------------------------------------
// Generated support rules
// ---------------------------------------------------------------------------

nh_cont_IDENT = _{ "_" | ALPHA | DIGIT }
nh_reserved_IDENT = @{ ("return" | "await" | "print" | "while" | "else" | "len" | "fn" | "if") ~ !nh_cont_IDENT }
nh_op_bang_eq = @{ "!=" }
nh_op_amp_amp = @{ "&&" }
