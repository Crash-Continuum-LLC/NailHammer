expect_item = { nh_kw_expect ~ #lit = STRING ~ nh_kw_in ~ #target = target_path ~ nh_kw_as ~ #msg = STRING ~ ";" }
target_path = { #head = IDENT ~ (#tail = dotted)* }
dotted = { "." ~ #name = IDENT }
alternatives = { #head = alternative ~ (#tail = more_alternative)* }
