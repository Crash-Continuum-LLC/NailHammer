rule_item = { (#quiet = silent_marker)? ~ nh_kw_rule ~ #name = IDENT ~ "=" ~ #body = alternatives ~ ";" }
silent_marker = { nh_kw_silent }
recover_item = { nh_kw_recover ~ #target = IDENT ~ nh_kw_sync ~ #sync = alt ~ ";" }
