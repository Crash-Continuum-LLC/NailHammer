// Implicit skipping
nh_skip_WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
nh_skip_LINE_COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }
nh_skip_BLOCK_COMMENT = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
WHITESPACE = _{ nh_skip_WHITESPACE | nh_skip_LINE_COMMENT | nh_skip_BLOCK_COMMENT }

// Tokens
ALPHA = @{ 'a'..'z' | 'A'..'Z' }
DIGIT = @{ '0'..'9' }
IDENT = @{ (ALPHA | "_") ~ (ALPHA | DIGIT | "_")* }
LAZY = @{ nh_kw_lazy ~ !(ALPHA | DIGIT | "_") ~ !":" }
STRING = @{ "\"" ~ (!("\"" | "\\") ~ ANY | "\\" ~ ANY)* ~ "\"" }
STRING_CI = @{ "^" ~ STRING }

// Rules
file = { SOI ~ (#decl = grammar_decl)? ~ (#items = item)* ~ EOI }
