// Generated by NailHammer from the `Config` grammar. DO NOT EDIT.
// Edit the .nh source and re-run `nh build`.

// Implicit skipping
nh_skip_WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
nh_skip_COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }
WHITESPACE = _{ nh_skip_WHITESPACE | nh_skip_COMMENT }

// Tokens
DIGIT = @{ '0'..'9' }
ALPHA = @{ 'a'..'z' | 'A'..'Z' }
IDENT = @{ !nh_reserved_IDENT ~ ((ALPHA | "_") ~ (ALPHA | DIGIT | "_" | "-")*) }
NUMBER_ = @{ "-"? ~ DIGIT+ ~ ("." ~ DIGIT+)? }
STRING = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

// Rules
document = { SOI ~ (#entries = entry)* ~ EOI }
entry = { #key = IDENT ~ "=" ~ #value = value ~ ";" }
value = { value_string | value_number | value_yes | value_no | value_null | value_list | value_table }
value_string = { #raw = STRING }
value_number = { #digits = NUMBER_ }
value_yes = { nh_kw_true }
value_no = { nh_kw_false }
value_null = { nh_kw_null }
value_list = { "[" ~ (#items = value)* ~ "]" }
value_table = { "{" ~ (#fields = entry)* ~ "}" }

// ---------------------------------------------------------------------------
// Generated support rules
// ---------------------------------------------------------------------------

nh_cont_IDENT = _{ "-" | "_" | ALPHA | DIGIT }
nh_reserved_IDENT = @{ ("false" | "null" | "true") ~ !nh_cont_IDENT }
nh_kw_true = @{ "true" ~ !nh_cont_IDENT }
nh_kw_false = @{ "false" ~ !nh_cont_IDENT }
nh_kw_null = @{ "null" ~ !nh_cont_IDENT }
