// Generated by NailHammer from the `Bc` grammar. DO NOT EDIT.
// Edit the .nh source and re-run `nh build`.

// Implicit skipping
nh_skip_WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
nh_skip_COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }
WHITESPACE = _{ nh_skip_WHITESPACE | nh_skip_COMMENT }

// Tokens
DIGIT = @{ '0'..'9' }
ALPHA = @{ 'a'..'z' | 'A'..'Z' }
NUMBER_ = @{ DIGIT+ ~ ("." ~ DIGIT+)? }
IDENT = @{ !nh_reserved_IDENT ~ ((ALPHA | "_") ~ (ALPHA | DIGIT | "_")*) }

// Expressions (operator table is resolved at build time)
expr = { nh_pre_op* ~ atom ~ (nh_bin_op ~ nh_pre_op* ~ atom)* }

// Rules
program = { SOI ~ (#stmts = stmt)* ~ EOI }
stmt = { nh_ok_stmt | nh_error_stmt }
nh_ok_stmt = { stmt_bind | stmt_print | stmt_iff | stmt_eval }
stmt_bind = { nh_kw_let ~ #name = IDENT ~ "=" ~ #value = expr ~ ";" }
stmt_print = { nh_kw_print ~ #value = expr ~ ";" }
stmt_iff = { nh_kw_if ~ #cond = expr ~ nh_kw_then ~ #body = stmt }
stmt_eval = { #value = expr ~ ";" }
atom = { primary }
primary = { primary_num | primary_var | "(" ~ #inner = expr ~ nh_expect_primary_rparen }
primary_num = { #digits = NUMBER_ }
primary_var = { #name = IDENT }

// ---------------------------------------------------------------------------
// Generated support rules
// ---------------------------------------------------------------------------

nh_expect_primary_rparen = _{ ")" }
nh_cont_IDENT = _{ "_" | ALPHA | DIGIT }
nh_reserved_IDENT = @{ ("print" | "then" | "let" | "if") ~ !nh_cont_IDENT }
nh_op_bang_eq = @{ "!=" }
nh_op_amp_amp = @{ "&&" }
nh_op_lt_eq = @{ "<=" }
nh_op_eq_eq = @{ "==" }
nh_op_gt_eq = @{ ">=" }
nh_op_pipe_pipe = @{ "||" }
nh_op_percent = @{ "%" }
nh_op_star = @{ "*" }
nh_op_plus = @{ "+" }
nh_op_minus = @{ "-" }
nh_op_slash = @{ "/" }
nh_op_lt = @{ "<" }
nh_op_eq = @{ "=" }
nh_op_gt = @{ ">" }
nh_bin_op = _{ nh_op_bang_eq | nh_op_amp_amp | nh_op_lt_eq | nh_op_eq_eq | nh_op_gt_eq | nh_op_pipe_pipe | nh_op_percent | nh_op_star | nh_op_plus | nh_op_minus | nh_op_slash | nh_op_lt | nh_op_eq | nh_op_gt }
nh_op_bang = @{ "!" }
nh_pre_op = _{ nh_op_bang | nh_op_minus }
nh_error_stmt = { (!(";") ~ ANY)+ ~ (";")? }
nh_kw_let = @{ "let" ~ !nh_cont_IDENT }
nh_kw_print = @{ "print" ~ !nh_cont_IDENT }
nh_kw_if = @{ "if" ~ !nh_cont_IDENT }
nh_kw_then = @{ "then" ~ !nh_cont_IDENT }
